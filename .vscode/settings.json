{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.prettier": "never",
    "source.removeUnused.ts": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "eslint.enable": true,
  "json.schemas": [
    {
      "fileMatch": ["docs/public/assets/tables/**/*.json"],
      "url": "./schemas/table.json"
    }
  ],
  "yaml.schemas": {
    "./schemas/redirects.json": ["docs/redirects.yaml"],
    "./schemas/section.json": ["docs/*/section.yaml"],
    "./schemas/tags.json": ["docs/tags.yaml"]
  },
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar"
  }
}
