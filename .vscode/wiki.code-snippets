{
  "Insert button": {
    "scope": "markdown",
    "prefix": "button",
    "body": "<Button link=\"$1\">$2</Button>"
  },
  "Insert card": {
    "scope": "markdown",
    "prefix": "card",
    "body": [
      "<Card",
      "    image=\"${1:/assets/images/}\"",
      "    title=\"$2\"",
      "    link=\"$3\"",
      "/>"
    ]
  },
  "Insert card grid": {
    "scope": "markdown",
    "prefix": "card grid",
    "body": [
      "<CardGrid>",
      "",
      "$1",
      "",
      "</CardGrid>"
    ]
  },
  "Insert code block with header": {
    "scope": "markdown",
    "prefix": "code block",
    "body": [
      "<CodeHeader path=\"$1\" />",
      "",
      "```${2:json}",
      "$3",
      "```"
    ]
  },
  "Insert example file": {
    "scope": "markdown",
    "prefix": "example file",
    "body": "<ExampleFile path=\"$1\" />"
  },
  "Insert folder view": {
    "scope": "markdown",
    "prefix": "folder view",
    "body": [
      "<FolderView :paths=\"[",
      "    '$1'",
      "]\" />",
    ]
  },
  "Insert label": {
    "scope": "markdown",
    "prefix": "label",
    "body": "<Label color=\"$1\">$2</Label>"
  },
  "Insert mermaid diagram": {
    "scope": "markdown",
    "prefix": "mermaid",
    "body": [
      "```mermaid",
      "${1:flowchart LR}",
      "$2",
      "```"
    ]
  },
  "Insert page dumper": {
    "scope": "markdown",
    "prefix": "page dumper",
    "body": [
      "<!-- page_dumper_start -->",
      "<!-- page_dumper_end -->"
    ]
  },
  "Insert spoiler": {
    "scope": "markdown",
    "prefix": "spoiler",
    "body": [
      "<Spoiler title=\"$1\">",
      "",
      "$2",
      "",
      "</Spoiler>"
    ]
  },
  "Insert table": {
    "scope": "markdown",
    "prefix": "table",
    "body": "<Table data=\"$1.json\" />"
  },
  "Insert tag": {
    "scope": "markdown",
    "prefix": "tag",
    "body": "<Tag name=\"${1:beginner}\" />"
  },
  "Insert wiki image": {
    "scope": "markdown",
    "prefix": "wiki image",
    "body": [
      "<WikiImage",
      "    src=\"${1:/assets/images/}\"",
      "    alt=\"$2\"",
      "    ${3:pixelated}",
      "/>"
    ]
  },
  "Embed YouTube video": {
    "scope": "markdown",
    "prefix": "youtube embed",
    "body": "<YouTubeEmbed id=\"$1\" />"
  },
}
