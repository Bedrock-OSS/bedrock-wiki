{
  "name": "bedrock-wiki",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "run-script-os",
    "build:win32": "set NODE_OPTIONS=--max-old-space-size=16384 && vitepress build docs",
    "build:darwin:linux": "export NODE_OPTIONS=--max-old-space-size=16384 && vitepress build docs",
    "fastbuild": "run-script-os",
    "fastbuild:win32": "set FAST_BUILD=true && set NODE_OPTIONS=--max-old-space-size=8192 && vitepress build docs",
    "fastbuild:darwin:linux": "export FAST_BUILD=true && export NODE_OPTIONS=--max-old-space-size=8192 && vitepress build docs",
    "preview": "vitepress preview docs",
    "lint": "eslint docs/.vitepress"
  },
  "devDependencies": {
    "@docsearch/css": "^3.8.3",
    "@docsearch/js": "^3.8.3",
    "@types/archiver": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^18.19.74",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vueuse/core": "^14.2.1",
    "archiver": "^7.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-vue": "^9.32.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "markdown-it": "^14.1.1",
    "markdown-it-mathjax3": "^4.3.2",
    "markdown-it-task-lists": "^2.1.1",
    "minimatch": "^10.2.4",
    "molang": "^2.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-markdown-list-tabwidth": "^1.2.0",
    "run-script-os": "^1.1.6",
    "sass": "^1.83.4",
    "shiki": "^4.0.2",
    "tga": "^1.0.7",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.31",
    "vue-eslint-parser": "^10.4.0"
  }
}
